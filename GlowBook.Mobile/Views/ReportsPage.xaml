<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GlowBook.Mobile.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource GbBabyPink}">

    <ContentPage.Content>
        <ScrollView>
            <Grid Padding="24">

                <Border Style="{StaticResource GbCard}">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="{Binding Title}"
                               Style="{StaticResource GbCardTitle}" />

                        <Label Text="Basisinzichten op basis van de lokale gegevens."
                               FontSize="14"
                               TextColor="Gray" />

                        <HorizontalStackLayout HorizontalOptions="End">
                            <Button Text="Vernieuwen"
                                    Style="{StaticResource GbPrimaryButton}"
                                    Command="{Binding LoadCommand}" />
                        </HorizontalStackLayout>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           HorizontalOptions="Center" />

                        <!-- Totaal aantal afspraken -->
                        <Border Style="{StaticResource GbItemCard}">
                            <Label FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Totaal aantal afspraken: " FontAttributes="Bold" />
                                        <Span Text="{Binding TotalAppointments}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Border>

                        <!-- Aantal per status -->
                        <Label Text="Afspraken per status"
                               FontAttributes="Bold"
                               Margin="0,6,0,0" />

                        <CollectionView ItemsSource="{Binding StatusStats}">
                            <CollectionView.EmptyView>
                                <Label Text="Nog geen gegevens."
                                       TextColor="Gray" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GbItemCard}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Label}" />
                                            <Label Grid.Column="1" Text="{Binding Count}" FontAttributes="Bold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Top 5 diensten -->
                        <Label Text="Top 5 geboekte diensten"
                               FontAttributes="Bold"
                               Margin="0,6,0,0" />

                        <CollectionView ItemsSource="{Binding TopServices}">
                            <CollectionView.EmptyView>
                                <Label Text="Nog geen gegevens."
                                       TextColor="Gray" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GbItemCard}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Label}" />
                                            <Label Grid.Column="1" Text="{Binding Count}" FontAttributes="Bold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="{Binding Error}"
                               TextColor="Red"
                               FontSize="13" />

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
