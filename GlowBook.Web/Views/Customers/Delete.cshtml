@model GlowBook.Model.Entities.Customer
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Customers_DeleteTitle"].Value;
}

<div class="gb-card mt-3">
    <div class="gb-card-title text-danger">@SR["Customers_DeleteTitle"]</div>

    <div class="alert alert-warning">
        @SR["Customers_DeleteConfirm"]
    </div>

    <dl class="row">
        <dt class="col-sm-2">@SR["Col_Name"]</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">@SR["Col_Phone"]</dt>
        <dd class="col-sm-10">@Model.Phone</dd>

        <dt class="col-sm-2">@SR["Col_Email"]</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary">@SR["Common_Cancel"]</a>
        <button type="submit" class="btn btn-danger ms-2">@SR["Action_Delete"]</button>
    </form>
</div>
