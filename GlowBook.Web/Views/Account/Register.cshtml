@model GlowBook.Web.Models.Account.RegisterViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Account_RegisterTitle"].Value;
}

<div class="gb-card mt-3" style="max-width: 450px; margin-inline: auto;">
    <div class="gb-card-title">@SR["Account_RegisterTitle"]</div>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">@SR["Account_Email"]</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DisplayName" class="form-label">@SR["Account_DisplayName"]</label>
            <input asp-for="DisplayName" class="form-control" />
            <span asp-validation-for="DisplayName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">@SR["Account_Password"]</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">@SR["Account_ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Login" class="btn btn-outline-secondary">@SR["Account_BackToLogin"]</a>
            <button type="submit" class="btn-gb">@SR["Account_RegisterButton"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
