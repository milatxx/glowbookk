@model List<GlowBook.Model.Entities.Service>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Services_Title"].Value;
    var q = ViewBag.Q as string;
    var sort = ViewBag.Sort as string ?? "name";
}

<div class="gb-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="gb-card-title">@SR["Services_Title"]</div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-gb">@SR["Services_New"]</a>
        }
    </div>

    <p class="text-muted mb-2">
        @SR["Services_Subtitle"]
    </p>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input class="form-control" name="q" value="@q" placeholder="@SR["Services_SearchPlaceholder"]" />
        </div>

        <div class="col-md-3">
            <select class="form-select" name="sort">
                <option value="name" selected="@(sort == "name")">@SR["Sort_NameAsc"]</option>
                <option value="name_desc" selected="@(sort == "name_desc")">@SR["Sort_NameDesc"]</option>
            </select>
        </div>

        <div class="col-md-3 text-end">
            <button class="btn-gb" type="submit">@SR["Action_Filter"]</button>
            <a class="btn btn-outline-secondary ms-2" asp-action="Index">@SR["Action_Reset"]</a>
        </div>
    </form>

    <div class="gb-table-wrapper">
        <table class="table table-hover align-middle mb-0 gb-table">
            <thead>
                <tr>
                    <th>@SR["Col_Category"]</th>
                    <th>@SR["Col_Name"]</th>
                    <th>@SR["Col_Duration"]</th>
                    <th>@SR["Col_Price"]</th>
                    <th style="width: 220px;">@SR["Col_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Category</td>
                        <td>@s.Name</td>
                        <td>@s.DurationMinutes</td>
                        <td>@s.Price.ToString("0.00")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary me-1">
                                @SR["Action_Details"]
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary me-1">
                                    @SR["Action_Edit"]
                                </a>
                                <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">
                                    @SR["Action_Delete"]
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
