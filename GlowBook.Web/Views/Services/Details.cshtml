@model GlowBook.Model.Entities.Service
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Services_DetailsTitle"].Value;
}

<div class="gb-card mt-3">
    <div class="gb-card-title">@SR["Services_DetailsTitle"]</div>

    <dl class="row mb-0">
        <dt class="col-sm-3">@SR["Col_Category"]</dt>
        <dd class="col-sm-9">@Model.Category</dd>

        <dt class="col-sm-3">@SR["Col_Name"]</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">@SR["Col_Duration"]</dt>
        <dd class="col-sm-9">@Model.DurationMinutes</dd>

        <dt class="col-sm-3">@SR["Col_Price"]</dt>
        <dd class="col-sm-9">@Model.Price.ToString("0.00")</dd>

        <dt class="col-sm-3">@SR["Col_Description"]</dt>
        <dd class="col-sm-9">
            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <span class="text-muted">@SR["Services_NoDescription"]</span>
            }
            else
            {
                @Model.Description
            }
        </dd>
    </dl>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">@SR["Common_BackToList"]</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-gb">@SR["Action_Edit"]</a>
        }
    </div>
</div>
