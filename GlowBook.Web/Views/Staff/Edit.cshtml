@model GlowBook.Model.Entities.Staff
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Staff_EditTitle"].Value;
}

<div class="gb-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="gb-card-title">@SR["Staff_EditTitle"]</div>
    </div>

    <p class="text-muted mb-3">
        @SR["Staff_EditSubtitle"]
    </p>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">@SR["Field_Name"]</label>
            <input class="form-control" asp-for="Name" />
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">@SR["Field_Email"]</label>
            <input class="form-control" asp-for="Email" />
            <span class="text-danger" asp-validation-for="Email"></span>
        </div>

        <div class="d-flex gap-2">
            <button class="btn-gb" type="submit">@SR["Common_Save"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@SR["Common_Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
