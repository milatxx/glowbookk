@model List<GlowBook.Model.Entities.Staff>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Staff_Title"].Value;
    var q = ViewBag.Q as string;
}

<div class="gb-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="gb-card-title">@SR["Staff_Title"]</div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-gb">@SR["Common_New"]</a>
        }
    </div>

    <p class="text-muted mb-2">
        @SR["Staff_Subtitle"]
    </p>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-8">
            <input class="form-control" name="q" value="@q" placeholder="@SR["Staff_SearchPlaceholder"]" />
        </div>

        <div class="col-md-4 text-end">
            <button class="btn-gb" type="submit">@SR["Action_Search"]</button>
            <a class="btn btn-outline-secondary ms-2" asp-action="Index">@SR["Action_Reset"]</a>
        </div>
    </form>

    <div class="gb-table-wrapper">
        <table class="table table-hover align-middle mb-0 gb-table">
            <thead>
                <tr>
                    <th>@SR["Col_Name"]</th>
                    <th>@SR["Col_Email"]</th>
                    <th style="width: 220px;">@SR["Col_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3">
                            <div class="alert alert-info mb-0">
                                @SR["Staff_None"]
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td>@s.Email</td>
                            <td class="text-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary me-1">
                                        @SR["Action_Edit"]
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">
                                        @SR["Action_Delete"]
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
