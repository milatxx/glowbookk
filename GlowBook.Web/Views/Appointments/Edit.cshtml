@model GlowBook.Model.Entities.Appointment
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Appointments_EditTitle"].Value;
}

<div class="gb-card mt-3">
    <div class="gb-card-title">@SR["Appointments_EditTitle"]</div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CustomerId" class="form-label">@SR["Field_Customer"]</label>
            <select asp-for="CustomerId"
                    asp-items="@(new SelectList((IEnumerable<GlowBook.Model.Entities.Customer>)ViewBag.Customers, "Id", "Name"))"
                    class="form-select">
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StaffId" class="form-label">@SR["Field_Staff"]</label>
            <select asp-for="StaffId"
                    asp-items="@(new SelectList((IEnumerable<GlowBook.Model.Entities.Staff>)ViewBag.Staff, "Id", "Name"))"
                    class="form-select">
            </select>
            <span asp-validation-for="StaffId" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Start" class="form-label">@SR["Field_Start"]</label>
                <input asp-for="Start"
                       class="form-control"
                       type="datetime-local"
                       step="60" />
                <span asp-validation-for="Start" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="End" class="form-label">@SR["Field_End"]</label>
                <input asp-for="End"
                       class="form-control"
                       type="datetime-local"
                       step="60" />
                <span asp-validation-for="End" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">@SR["Field_Status"]</label>
            <input asp-for="Status" class="form-control" />
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">@SR["Common_Cancel"]</a>
            <button type="submit" class="btn-gb">@SR["Common_Save"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
