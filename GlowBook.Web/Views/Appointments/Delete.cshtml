@model GlowBook.Model.Entities.Appointment
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Appointments_DeleteTitle"].Value;
}

<div class="gb-card mt-3">
    <div class="gb-card-title text-danger">@SR["Appointments_DeleteTitle"]</div>

    <div class="alert alert-warning">
        @SR["Appointments_DeleteConfirm"]
    </div>

    <dl class="row">
        <dt class="col-sm-3">@SR["Field_Date"]</dt>
        <dd class="col-sm-9">@Model.Start.ToString("dd/MM/yyyy HH:mm") - @Model.End.ToString("HH:mm")</dd>

        <dt class="col-sm-3">@SR["Field_Customer"]</dt>
        <dd class="col-sm-9">@Model.Customer?.Name</dd>

        <dt class="col-sm-3">@SR["Field_Staff"]</dt>
        <dd class="col-sm-9">@Model.Staff?.Name</dd>

        <dt class="col-sm-3">@SR["Field_Status"]</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary">@SR["Common_Cancel"]</a>
        <button type="submit" class="btn btn-danger ms-2">@SR["Action_Delete"]</button>
    </form>
</div>
