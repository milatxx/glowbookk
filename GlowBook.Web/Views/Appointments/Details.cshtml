@model GlowBook.Model.Entities.Appointment
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GlowBook.Web.SharedResources> SR

@{
    ViewData["Title"] = SR["Appointments_DetailsTitle"].Value;
}

<div class="gb-card mt-3">
    <div class="gb-card-title">@SR["Appointments_DetailsTitle"]</div>

    <dl class="row mb-0">
        <dt class="col-sm-3">@SR["Field_Date"]</dt>
        <dd class="col-sm-9">@Model.Start.ToString("f")</dd>

        <dt class="col-sm-3">@SR["Field_End"]</dt>
        <dd class="col-sm-9">@Model.End.ToString("t")</dd>

        <dt class="col-sm-3">@SR["Field_Customer"]</dt>
        <dd class="col-sm-9">@Model.Customer?.Name</dd>

        <dt class="col-sm-3">@SR["Field_Staff"]</dt>
        <dd class="col-sm-9">@Model.Staff?.Name</dd>

        <dt class="col-sm-3">@SR["Field_Status"]</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">@SR["Common_BackToList"]</a>
        @if (User.HasClaim("permission", "manage_appointments"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-gb">@SR["Action_Edit"]</a>
        }
    </div>
</div>
